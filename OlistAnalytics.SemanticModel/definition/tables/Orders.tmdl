	column 'Has Comment'
		dataType: boolean
		lineageTag: ba3ea055-7c4b-449e-b563-af31b6a17019
		summarizeBy: none
		sourceColumn: Has Comment

	partition Orders = m
		mode: import
		queryGroup: Facts
		source =
				let
					Source = stg_Orders,
					MergedItems = Table.NestedJoin(Source, {"order_id"}, stg_ItemsByOrder, {"order_id"}, "I", JoinKind.LeftOuter),
					ExpandedItems = Table.ExpandTableColumn(MergedItems, "I", {"Items", "Order Value", "Order Freight"}),
					MergedReviews = Table.NestedJoin(ExpandedItems, {"order_id"}, stg_ReviewsByOrder, {"order_id"}, "R", JoinKind.LeftOuter),
					ExpandedReviews = Table.ExpandTableColumn(MergedReviews, "R", {"Review Score", "Has Comment"}),
					MergedPayments = Table.NestedJoin(ExpandedReviews, {"order_id"}, stg_PaymentsByOrder, {"order_id"}, "P", JoinKind.LeftOuter),
					ExpandedPayments = Table.ExpandTableColumn(MergedPayments, "P", {"Payment Type", "Installments", "Payment Value"}),
					FilledPaymentType = Table.ReplaceValue(ExpandedPayments, null, "Unknown", Replacer.ReplaceValue, {"Payment Type"}),
					AddedReviewBand = Table.AddColumn(FilledPaymentType, "Review Band", each
						if [Review Score] = null then "No Review"
						else if [Review Score] < 2.5 then "Negative (1-2)"
						else if [Review Score] < 3.5 then "Neutral (3)"
						else "Positive (4-5)", type text),
					Renamed = Table.RenameColumns(AddedReviewBand, {{"order_id", "Order ID"}}),
					Selected = Table.SelectColumns(Renamed, {"Order Key", "Order ID", "Order Date", "Delivered Date", "Estimated Date", "Customer ID", "Order Status", "Delivery Status", "Delay Bucket", "Delay Bucket Order", "Delivery Days", "Days Late", "Items", "Order Value", "Order Freight", "Payment Type", "Installments", "Payment Value", "Review Score", "Review Band", "Has Comment"}),
					Typed = Table.TransformColumnTypes(Selected, {{"Order Key", Int64.Type}, {"Order Date", type date}, {"Delivered Date", type date}, {"Estimated Date", type date}, {"Delay Bucket Order", Int64.Type}, {"Delivery Days", type number}, {"Days Late", Int64.Type}, {"Items", Int64.Type}, {"Order Value", Currency.Type}, {"Order Freight", Currency.Type}, {"Installments", Int64.Type}, {"Payment Value", Currency.Type}, {"Review Score", type number}, {"Has Comment", type logical}})
				in
					Typed

