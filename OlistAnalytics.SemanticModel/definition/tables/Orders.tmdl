		sourceColumn: Delivery Days

	column 'Days Late'
		dataType: int64
		formatString: 0
		lineageTag: c8d4ae53-b82f-40eb-9ad0-eb27152ef115
		summarizeBy: none
		sourceColumn: Days Late

	column Items
		dataType: int64
		formatString: 0
		lineageTag: e1943a7f-35a9-44e7-8dc9-36a1ccddd332
		summarizeBy: none
		sourceColumn: Items

	column 'Order Value'
		dataType: decimal
		formatString: \R\$ #,0.00
		lineageTag: e095d86c-f6f5-48c8-8b77-91aa04b9f3a2
		summarizeBy: none
		sourceColumn: Order Value

