	column Installments
		dataType: int64
		formatString: 0
		lineageTag: a1b7de3e-4899-4ae8-bbe3-c17bf83defa0
		summarizeBy: none
		sourceColumn: Installments

	column 'Payment Value'
		dataType: decimal
