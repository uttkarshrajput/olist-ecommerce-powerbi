/// Fact table at order grain: delivery performance, payment and review per order (includes cancelled orders).
table Orders
	lineageTag: 2bc0a356-031d-48d9-b52b-ffe601531b81

	column 'Order Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: eaa31e0e-8ebb-41e9-9f45-7cff96226670
		summarizeBy: none
		sourceColumn: Order Key

	column 'Order ID'
		dataType: string
		lineageTag: 63af784a-d6bc-422b-9710-3a8d84d003f8
		summarizeBy: none
		sourceColumn: Order ID

	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: a53d6a62-ee62-48d4-979a-0211ee566614
		summarizeBy: none
		sourceColumn: Order Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Delivered Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 770814df-c49a-485c-bacd-38f22985ae24
		summarizeBy: none
		sourceColumn: Delivered Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Estimated Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: ca207cbb-6a44-4782-8de3-8416b457c87e
		summarizeBy: none
		sourceColumn: Estimated Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Customer ID'
		dataType: string
		isHidden
		lineageTag: 8d74a5af-de73-4038-9cd0-ca42375d2a9a
		summarizeBy: none
		sourceColumn: Customer ID

	column 'Order Status'
		dataType: string
		lineageTag: a121dc00-0b38-43f1-87fb-693fb544245a
		summarizeBy: none
		sourceColumn: Order Status

	column 'Delivery Status'
		dataType: string
		lineageTag: 45b50ca6-96ae-4ddc-b4f5-ba78dc3a5b96
		summarizeBy: none
		sourceColumn: Delivery Status

	column 'Delay Bucket'
		dataType: string
		lineageTag: 6ce0828c-02f0-4b71-a532-cca3f0dd84a3
		summarizeBy: none
		sourceColumn: Delay Bucket
		sortByColumn: 'Delay Bucket Order'

	column 'Delay Bucket Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2ed00ae3-3abd-48ac-8118-daaf195c277d
		summarizeBy: none
		sourceColumn: Delay Bucket Order

	column 'Delivery Days'
		dataType: double
		formatString: 0.0
		lineageTag: 59cbc1e7-fd74-4092-83ab-8208cdcef5f0
